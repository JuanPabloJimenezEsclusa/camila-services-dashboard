{
  "name": "camila-product-react-ui",
  "version": "1.0.0",
  "type": "module",
  "description": "React SPA for Camila Product API",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:mocked": "./run-e2e-mocked.sh",
    "test:all": "npm run test:run && npm run test:e2e",
    "test:ci": "./run-all-tests.sh --skip-e2e",
    "docker:build": "docker build -t camila-product-react-ui:1.0.0 .",
    "docker:run": "./run-docker.sh",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f camila-ui"
  },
  "dependencies": {
    "@types/protobufjs": "^6.0.0",
    "axios": "^1.7.9",
    "cbor-x": "^1.6.0",
    "chart.js": "^4.5.1",
    "chartjs-chart-matrix": "^3.0.0",
    "graphql": "^16.12.0",
    "graphql-request": "^7.4.0",
    "grpc-web": "^2.0.2",
    "i18next": "^25.8.0",
    "lodash.debounce": "^4.0.8",
    "oidc-client-ts": "^3.4.1",
    "protobufjs": "^8.0.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-i18next": "^16.5.3",
    "react-router-dom": "^7.1.3",
    "rsocket-core": "^0.0.29-alpha.0",
    "rsocket-flowable": "^0.0.29-alpha.0",
    "rsocket-websocket-client": "^0.0.29-alpha.0",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@openapitools/openapi-generator-cli": "^2.16.4",
    "@playwright/test": "^1.58.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/google-protobuf": "^3.15.12",
    "@types/lodash.debounce": "^4.0.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^17.3.0",
    "grpc-tools": "^1.13.1",
    "happy-dom": "^20.4.0",
    "jsdom": "^27.4.0",
    "msw": "^2.12.7",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^6.0.6",
    "vitest": "^4.0.18"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}