# Environment variables for Camila Product UI
# Copy this file to .env.local and modify as needed

# =============================================================================
# AUTHENTICATION (Keycloak/OAuth2)
# =============================================================================
# Set to 'false' to disable authentication (useful for development/testing)
VITE_AUTH_ENABLED=true

# Keycloak/OAuth2 Configuration (only used when VITE_AUTH_ENABLED=true)
VITE_AUTH_AUTHORITY=http://localhost:9191/realms/camila-realm
VITE_AUTH_CLIENT_ID=camila-client
VITE_AUTH_CLIENT_SECRET=Fuvf8XyBDXxU57NAOOFZVvdUIPmGgiyE

# =============================================================================
# BACKEND API ENDPOINTS
# =============================================================================
# REST API Base URL
VITE_API_BASE_URL=http://localhost:8090/product-dev/api

# GraphQL Endpoint
VITE_GRAPHQL_ENDPOINT=http://localhost:8090/product-dev/api/graphql

# gRPC Endpoint (via Envoy proxy)
# Development: Uses Vite proxy to forward to Envoy
# Production: Direct connection to Envoy or use relative path
VITE_GRPC_ENDPOINT=http://localhost:8765

# RSocket WebSocket URL
VITE_RSOCKET_URL=ws://localhost:7000/product-dev/api/rsocket

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# API Version Header
VITE_API_VERSION=1.0.0

# Default Language
VITE_DEFAULT_LANGUAGE=en-US

# Application Port (development server)
VITE_PORT=3030

# =============================================================================
# PRODUCTION OVERRIDES (Docker/Nginx)
# These will be replaced at runtime via docker-entrypoint.sh
# =============================================================================
# Use relative paths in production or provide full URLs
# Example for production:
# VITE_API_BASE_URL=/product-dev/api
# VITE_GRAPHQL_ENDPOINT=/product-dev/api/graphql
# VITE_AUTH_AUTHORITY=https://auth.example.com/realms/camila-realm
